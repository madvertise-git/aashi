{
  "name": "aashi",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "e2e": "pnpm --filter @aashi/web e2e",
    "db:bootstrap": "pnpm --filter @aashi/db bootstrap",
    "db:migrate": "pnpm --filter @aashi/db migrate",
    "db:check-rls": "pnpm --filter @aashi/db check-rls"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
