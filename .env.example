# Local development only. Real secrets live in AWS Secrets Manager, never in code.
# Everyday connection: the app role, which cannot bypass row-level security.
DATABASE_URL=postgres://platform_app:app_dev_password@localhost:5432/aashi
# Migrations only: the owner role.
DATABASE_OWNER_URL=postgres://platform_owner:owner_dev_password@localhost:5432/aashi
# Where the web app proxies /api/* to.
API_URL=http://localhost:4000
