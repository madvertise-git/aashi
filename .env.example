# Local development only. Real secrets live in AWS Secrets Manager, never in code.
# Everyday connection: the app role, which cannot bypass row-level security.
DATABASE_URL=postgres://platform_app:app_dev_password@localhost:5432/aashi
# The sign-in engine (Better Auth): a role that can reach only the sign-in tables.
AUTH_DATABASE_URL=postgres://platform_auth:auth_dev_password@localhost:5432/aashi
# Sessions and rate limits. Leave unset to keep them in the API's memory (local development only).
REDIS_URL=redis://localhost:6379
# Signs cookies and encrypts two-factor secrets. Required in production: 32+ random characters.
AUTH_SECRET=
# Where the web app is served; used in links in emails.
APP_URL=http://localhost:3000
# Migrations only: the owner role.
DATABASE_OWNER_URL=postgres://platform_owner:owner_dev_password@localhost:5432/aashi
# Where the web app proxies /api/* to.
API_URL=http://localhost:4000
# Meta and AI are answered by stand-ins until Phase 6. "realistic" makes them slow and flaky like the real services.
STANDIN_BEHAVIOUR=calm
