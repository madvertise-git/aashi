{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL", "DATABASE_OWNER_URL", "AUTH_DATABASE_URL", "REDIS_URL", "AUTH_SECRET", "APP_URL", "APP_NAME", "KEY_PREFIX", "STANDIN_BEHAVIOUR", "TRUSTED_PROXY_HOPS", "API_URL", "NODE_ENV", "PORT"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}
